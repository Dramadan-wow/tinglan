<RCC>
  <qresource prefix="/music"><file alias="mist.wav">@IM_ASSET_ROOT@/music/mist.wav</file></qresource>
  <qresource prefix="/art"><file alias="yvonne-social.png">@IM_ASSET_ROOT@/art/yvonne-social.png</file><file alias="mist-river.png">@IM_ASSET_ROOT@/art/mist-river-v3.png</file></qresource>
  <qresource prefix="/icons"><file alias="chevron-down.xpm">@IM_ASSET_ROOT@/icons/chevron-down.xpm</file><file alias="chevron-up.xpm">@IM_ASSET_ROOT@/icons/chevron-up.xpm</file><file alias="check.xpm">@IM_ASSET_ROOT@/icons/check.xpm</file></qresource>
  <qresource prefix="/payment"><file alias="wechat.jpg">@IM_PAYMENT_RESOURCE@</file></qresource>
</RCC>
